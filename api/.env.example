# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# JWT Secret for LE agency tokens (generate with: openssl rand -hex 64)
LE_API_SECRET=change-this-to-a-secure-random-secret

# Agency self-registration secret (share only with vetted LE agencies)
AGENCY_REGISTRATION_SECRET=another-secure-secret

# Server
PORT=3000
NODE_ENV=production

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://ftc.gov,https://fbi.gov,https://ic3.gov

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_AGENCY=500

# JWT expiry
JWT_EXPIRES_IN=24h

# Firestore collection names (defaults match ScamShield app)
INCIDENTS_COLLECTION=callAnalysis
AGENCIES_COLLECTION=leAgencies

# ScamShield LE Portal — Environment Variables
# Copy this file to .env.local and fill in your values

# ScamShield LE API base URL
NEXT_PUBLIC_LE_API_URL=https://your-api-url.run.app

# Mapbox token (free tier: 50k map loads/month)
# Get yours at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbHh4eHh4eHgwMDAwMnFxeHh4eHh4eHgifQ.your_signature_here

# Must match LE_JWT_SECRET on the API server
LE_JWT_SECRET=your-super-secret-jwt-key-min-32-chars
